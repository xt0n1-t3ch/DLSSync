{
  "name": "dlssync",
  "version": "1.6.7",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "prebuild:kill": "node scripts/kill-dlssync.mjs",
    "check": "pnpm --filter dlssync-frontend check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "test": "task test",
    "test:e2e": "pnpm --filter dlssync-frontend exec playwright test --config ../tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "axe-core": "4.10.3"
  },
  "packageManager": "pnpm@9.0.0"
}
